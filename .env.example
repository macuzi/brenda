CHROMA_API_KEY=your_key_here
CHROMA_TENANT=your_tenant_here
CHROMA_DATABASE=brenda
CHROMA_COLLECTION=brenda-a11y

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Sentry error/performance monitoring. Leave SENTRY_DSN empty to disable
# monitoring (the app runs normally). Do not commit a real DSN — this repo is
# public and a committed DSN can be abused to spam events into the project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
